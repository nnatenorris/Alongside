# Copy this file to .env and fill in your details.
# See ../docs/SETUP.md for how to generate an AOL app password.

PORT=4100

# --- AOL IMAP (reading mail) ---------------------------------------------
# Host/port rarely need to change for AOL. EMAIL_USER is your full address
# (e.g. yourname@aol.com). EMAIL_APP_PASSWORD must be an *app password*
# generated at https://login.aol.com/myaccount/security — your normal
# AOL password will not work here.
IMAP_HOST=imap.aol.com
IMAP_PORT=993
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- AOL SMTP (sending mailto: unsubscribe requests) ----------------------
# Optional. Without this, mailto-only unsubscribe requests are recorded
# but not actually sent — you'll see them queued as "manual" in the UI.
SMTP_HOST=smtp.aol.com
SMTP_PORT=465

# --- Local storage & sync ---------------------------------------------------
# Where the local SQLite cache lives (never contains your password).
DB_PATH=./data/email-manager.sqlite

# Leave unset to disable automatic background sync; the UI's "Sync now"
# button always works regardless. Cron syntax, e.g. "*/15 * * * *" = every
# 15 minutes.
SYNC_CRON=

# How many recent messages to pull per folder on each sync.
SYNC_FETCH_LIMIT=200

# If EMAIL_USER/EMAIL_APP_PASSWORD are left blank, the server runs in demo
# mode: it serves realistic seeded sample mail instead of a live AOL
# connection, so you can try the whole app before wiring up real
# credentials.
